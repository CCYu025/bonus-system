generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum PersonStatus {
  active
  terminated
}

enum UserRole {
  developer
  foreman
}

model User {
  id           String   @id @default(cuid())
  username     String   @unique
  passwordHash String
  role         UserRole
  displayName  String
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions Session[]

  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("session")
}

model Person {
  id         String       @id @default(cuid())
  employeeId String       @unique
  name       String
  status     PersonStatus @default(active)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  records AttendanceRecord[]

  @@map("person")
}

model AttendanceCategory {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  // 事假／病假／特休為 true（docs/2026-08-03-attendance-leave-lock-sop-field）：
  // 該類別的記錄同列鎖定加班時數／配合度／3S表現／SOP表現／實際產量（備註不受影響）。
  locksExtendedFields Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  records AttendanceRecord[]

  @@map("attendance_category")
}

// 配合度 — 可透過畫面新增/編輯（不同於 AttendanceCategory，見
// docs/2026-08-01-attendance-extended-fields/spec.md AC-1）。刻意不含分數/權重
// 欄位：評分系統是另一個未來需求，這裡只負責收資料。
model ComplianceRating {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  @@map("compliance_rating")
}

// 3S表現 — 可透過畫面新增/編輯，結構同 ComplianceRating。
model ThreeSPerformance {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  // 標記「正常」這筆為系統預設值來源（docs/2026-08-03-attendance-leave-lock-sop-field）：
  // 不可被停用／編輯／刪除（見 src/lib/three-s-performance.ts 的守門判斷），
  // 其餘選項維持既有開放 CRUD，不受影響。
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  @@map("three_s_performance")
}

// SOP表現 — 結構同 ThreeSPerformance／ComplianceRating，可透過畫面新增/編輯，
// 不含分數/權重欄位（docs/2026-08-03-attendance-leave-lock-sop-field）。
model SopPerformance {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  // 標記「正常」這筆為系統預設值來源，不可被停用／編輯／刪除，比照 ThreeSPerformance.isLocked。
  isLocked  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  records AttendanceRecord[]

  @@map("sop_performance")
}

enum FormStatus {
  draft
  pending_review
  approved
  rejected
  voided
}

model AttendanceForm {
  id       String     @id @default(cuid())
  date     String // YYYY-MM-DD
  status   FormStatus @default(draft)
  version  Int        @default(1)

  // Version chain for void-and-resubmit (AC-10): previous form is kept, marked "voided",
  // and linked forward to the new form that supersedes it.
  previousFormId String?         @unique
  previousForm   AttendanceForm? @relation("FormVersionChain", fields: [previousFormId], references: [id])
  nextForm       AttendanceForm? @relation("FormVersionChain")

  // Non-null only while this form is the live (non-voided) chain head for `date`;
  // set to null on void so a new head can reuse the date without violating the DB unique
  // constraint required by NFR-1 (SQLite/Postgres unique indexes allow multiple NULLs).
  activeDateKey String? @unique

  rejectReason String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  records   AttendanceRecord[]
  auditLogs AuditLog[]

  @@map("attendance_form")
}

model AttendanceRecord {
  id         String              @id @default(cuid())
  formId     String
  form       AttendanceForm      @relation(fields: [formId], references: [id])
  // References Person's surrogate key (id), not the mutable employeeId business
  // key — see docs/2026-07-31-attendance-record-personid-migration/spec.md.
  // This lets Person.employeeId/name be corrected later without touching any
  // AttendanceRecord row.
  personId   String
  person     Person              @relation(fields: [personId], references: [id])
  date       String // denormalized from form.date, needed for the active-record uniqueness key
  categoryId String?
  category   AttendanceCategory? @relation(fields: [categoryId], references: [id])
  note       String?

  // 以下四欄為 docs/2026-08-01-attendance-extended-fields 新增，皆可為 null：
  // "有資料就有分數，未填視為無資料"，本次不做必填限制、不做分數換算。
  // categoryId 為 null（未填）時，saveFormRecords 會強制把這四欄與 note 一併清空
  // （AC-6/AC-7/AC-8），不可只在前端擋。
  overtimeHours       Int? // 1–10 的整數，UI 不提供 0 這個選項
  complianceRatingId  String?
  complianceRating    ComplianceRating?   @relation(fields: [complianceRatingId], references: [id])
  threeSPerformanceId String?
  threeSPerformance   ThreeSPerformance?  @relation(fields: [threeSPerformanceId], references: [id])
  actualQuantity      Int? // 實際產量，僅允許正整數

  // docs/2026-08-03-attendance-leave-lock-sop-field 新增，結構與上面四欄同一套規則：
  // categoryId 為 null，或 category.locksExtendedFields 為 true 時強制清空。
  sopPerformanceId String?
  sopPerformance   SopPerformance? @relation(fields: [sopPerformanceId], references: [id])

  voided Boolean @default(false)

  // "${personId}:${date}" while voided = false, else null.
  // Enforces NFR-1 / AC-8 (one active record per person+date) at the DB layer while still
  // allowing AC-10's voided history rows to share the same person+date.
  activeKey String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([personId, formId])
  @@map("attendance_record")
}

model AuditLog {
  id           String         @id @default(cuid())
  formId       String
  form         AttendanceForm @relation(fields: [formId], references: [id])
  action       String // created | saved_draft | submitted | approved | rejected | voided_resubmitted
  operatorName String
  note         String?
  createdAt    DateTime       @default(now())

  @@map("audit_log")
}
