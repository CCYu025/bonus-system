# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# sqlite local database (regenerate via `npm run db:migrate` + `npm run db:seed`)
/prisma/dev.db
/prisma/dev.db-journal

# sqlite test database (rebuilt from scratch by test/global-setup.ts on every `npm test`)
/prisma/test.db
/prisma/test.db-journal

# third-party agent skill docs auto-installed by `prisma init` (regenerate via prisma CLI)
/.claude/skills
/.agents
/.windsurf
skills-lock.json
